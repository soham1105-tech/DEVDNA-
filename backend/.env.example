# Copy this file to backend/.env and fill in values. Never commit backend/.env.

# --- Gemma 4 (Google Gen AI SDK / Gemini API) ---------------------------------
# Create a key at https://aistudio.google.com/apikey . Read only by the backend.
GEMINI_API_KEY=your-key-here
# GOOGLE_API_KEY is also accepted if GEMINI_API_KEY is not set.
GEMMA_MODEL=gemma-4-26b-a4b-it
# Seconds to wait for a streamed Gemma response
DEVDNA_AI_TIMEOUT=180
# Auth: set a token to require X-DevDNA-Token on every /api call (paste it in
# the frontend under Settings). Without a token the server refuses to start
# unless DEVDNA_LOCAL_ONLY=true acknowledges unauthenticated localhost use.
DEVDNA_API_TOKEN=
DEVDNA_LOCAL_ONLY=true
DEVDNA_RATE_LIMIT_PER_MINUTE=120

# --- Local repository analysis (optional) ------------------------------------
# Folders the backend may analyse in place (read-only). Separate multiple roots
# with ';' on Windows or ':' on macOS/Linux. Leave empty to disable.
DEVDNA_ALLOWED_LOCAL_ROOTS=

# --- Limits -------------------------------------------------------------------
DEVDNA_MAX_UPLOAD_MB=150
DEVDNA_MAX_ZIP_ENTRIES=10000
DEVDNA_MAX_UNCOMPRESSED_MB=500
DEVDNA_EXPERIMENT_TIMEOUT=90

# --- Server -------------------------------------------------------------------
DEVDNA_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# DEVDNA_DATA_DIR=./data
# DEVDNA_DATABASE_URL=sqlite:///./data/devdna.db
